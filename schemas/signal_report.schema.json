{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P01-005 Signal Report",
  "type": "object",
  "required": [
    "schema_version",
    "source_schema_version",
    "quality_schema_version",
    "generated_at",
    "engine",
    "rules_version",
    "signals",
    "summary",
    "semantics"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "engine": {
      "const": "P01-005"
    },
    "source_schema_version": {
      "type": "string"
    },
    "quality_schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_id",
          "signal_id",
          "direction",
          "strength",
          "confidence",
          "value",
          "unit",
          "evidence",
          "reason"
        ],
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "signal_id": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "RISK_ON",
              "RISK_OFF",
              "NEUTRAL",
              "UNKNOWN"
            ]
          },
          "strength": {
            "enum": [
              "WEAK",
              "MODERATE",
              "STRONG",
              "UNKNOWN"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "risk_on",
        "risk_off",
        "neutral",
        "unknown"
      ]
    },
    "semantics": {
      "type": "object"
    }
  },
  "additionalProperties": false
}