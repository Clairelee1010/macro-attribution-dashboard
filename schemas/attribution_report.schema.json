{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P01-007 Attribution Report",
  "type": "object",
  "required": ["schema_version","source_schema_version","generated_at","engine","rules_version","regime","regime_score","regime_confidence","attribution_confidence","evidence_agreement","drivers","supporting_evidence","conflicting_evidence","contextual_evidence","excluded","summary","semantics"],
  "properties": {
    "schema_version": {"const": "7.0"},
    "source_schema_version": {"const": "6.0"},
    "generated_at": {"type": "string"},
    "engine": {"const": "P01-007"},
    "rules_version": {"type": "string"},
    "regime": {"enum": ["RISK_ON","NEUTRAL","RISK_OFF","UNKNOWN"]},
    "regime_score": {"type": "number", "minimum": -1, "maximum": 1},
    "regime_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "attribution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_agreement": {"type": "number", "minimum": 0, "maximum": 1},
    "drivers": {"type": "array", "items": {"$ref": "#/$defs/driver"}},
    "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/driver"}},
    "conflicting_evidence": {"type": "array", "items": {"$ref": "#/$defs/driver"}},
    "contextual_evidence": {"type": "array", "items": {"$ref": "#/$defs/driver"}},
    "excluded": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "object"},
    "semantics": {"type": "object"}
  },
  "$defs": {
    "driver": {
      "type": "object",
      "required": ["metric_id","direction","strength","signal_confidence","weight","weighted_score","contribution_share","relation_to_regime"],
      "properties": {
        "metric_id": {"type": "string"},
        "signal_id": {"type": ["string","null"]},
        "direction": {"type": "string"},
        "strength": {"type": "string"},
        "signal_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "weight": {"type": "number", "minimum": 0},
        "weighted_score": {"type": "number"},
        "contribution_share": {"type": "number", "minimum": 0, "maximum": 1},
        "relation_to_regime": {"enum": ["SUPPORTING","CONFLICTING","CONTEXT","NEUTRAL"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
