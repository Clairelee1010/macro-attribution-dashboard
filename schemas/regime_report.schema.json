{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P01-006 Market Regime Report",
  "type": "object",
  "required": [
    "schema_version",
    "source_schema_version",
    "generated_at",
    "engine",
    "rules_version",
    "regime",
    "score",
    "confidence",
    "coverage",
    "contradiction",
    "drivers",
    "supporting",
    "contradicting",
    "excluded",
    "summary",
    "semantics"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "source_schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "engine": {
      "const": "P01-006"
    },
    "rules_version": {
      "type": "string"
    },
    "regime": {
      "enum": [
        "RISK_ON",
        "NEUTRAL",
        "RISK_OFF",
        "UNKNOWN"
      ]
    },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contradiction": {
      "type": "boolean"
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supporting": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contradicting": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "semantics": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
